@{
    ViewData["Title"] = "Counselling and support";
}

<section class="hero-section">
    <div class="container hero-content">
        <p class="eyebrow">A place to begin</p>
        <h1>Make space for what matters.</h1>
        <p class="hero-copy">Counselling offers time to pause, reflect, and explore what might help you move forward.</p>
        <a class="btn btn-primary btn-lg" href="#sessions">Explore sessions</a>
    </div>
</section>

<section class="content-section" id="approach">
    <div class="container narrow-container">
        <p class="eyebrow">A thoughtful approach</p>
        <h2>A space to talk, at your pace.</h2>
        <p class="section-copy">Starting counselling can feel like a big step. This is a welcoming place to learn about the support offered and decide what feels right for you.</p>
    </div>
</section>

<section class="sessions-section" id="sessions">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Sessions</p>
            <h2>Explore your options</h2>
            <p>Session formats, durations, and fees will be listed here once confirmed.</p>
        </div>
        <div class="session-card">
            <div>
                <h3>Individual counselling</h3>
                <p>Information about who sessions are for and what to expect can be added here.</p>
            </div>
            <a class="text-link" href="#contact">Ask about sessions <span aria-hidden="true">&rarr;</span></a>
        </div>
    </div>
</section>

<section class="contact-section" id="contact">
    <div class="container contact-content">
        <p class="eyebrow">Getting started</p>
        <h2>Take the next step when you’re ready.</h2>
        <p>Contact information and booking options will be added here.</p>
    </div>
</section>
